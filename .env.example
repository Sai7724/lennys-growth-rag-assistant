# ─── The Lenny Growth Assistant — Environment Configuration ───────────────────
# Copy to .env and adjust. All values shown are safe local defaults.

# --- PostgreSQL / pgvector ---
# Inside docker-compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/lenny_assistant

# --- LLM Provider Toggle ---
# "ollama" (local) | "gemini" | "glm" | "huggingface" (cloud)
DEFAULT_PROVIDER=ollama

# --- Ollama (Local) ---
# When running the backend in Docker, docker-compose sets this to
# http://host.docker.internal:11434 so it can reach Ollama on the host.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Cloud providers (optional — only needed if you enable them) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GLM_API_KEY=
GLM_MODEL=glm-4.7-flash
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- RAG / Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.65
TOP_K=5

# --- Ingestion ---
# Git repo to clone/pull Lenny's transcripts from (empty => local files only).
# Layout expected: episodes/{guest}/transcript.md with YAML frontmatter.
TRANSCRIPTS_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts.git
# Where transcripts live / where the repo gets cloned.
TRANSCRIPTS_DIR=./data/transcripts
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000